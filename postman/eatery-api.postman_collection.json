{
  "info": {
    "name": "Eatery Management API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth Signup",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"Test User\",\n  \"email\": \"test@example.com\",\n  \"password\": \"password123\",\n  \"address\": \"123 Test Street\"\n}"
        },
        "url": { "raw": "http://localhost:8000/api/auth/signup", "host": ["http://localhost:8000"], "path": ["api", "auth", "signup"] }
      }
    },
    {
      "name": "Get Menu",
      "request": {
        "method": "GET",
        "url": { "raw": "http://localhost:8000/api/menu", "host": ["http://localhost:8000"], "path": ["api", "menu"] }
      }
    }
  ]
}
